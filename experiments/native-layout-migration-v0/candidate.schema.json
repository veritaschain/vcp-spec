    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "hex": {
      "type": "string",
      "pattern": "^([0-9a-f]{2})*$",
      "maxLength": 131072
    },
    "signature": {
      "type": "string",
